    "for name, model in tuned_models.items():\n",
    "    probs = model.predict_proba(X_test)[:, 1]   # all evaluated on the real, full X_test\n",
    "    fpr, tpr, _ = roc_curve(y_test, probs)\n",
    "    auc = roc_auc_score(y_test, probs)\n",
    "    plt.plot(fpr, tpr, linewidth=2, label=f\"{name} (tuned) (AUC = {auc:.3f})\")\n",
    "\n",
    "# ---- Diagonal reference line (random guessing) ----\n",
    "plt.plot([0, 1], [0, 1], 'k--', label='Random guess')\n",
    "\n",
    "plt.xlabel('False Positive Rate')\n",
    "plt.ylabel('True Positive Rate')\n",
    "plt.title('ROC Curve Comparison — Tuned vs. Untuned Models')\n",
    "plt.legend(loc='lower right', fontsize=9)\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
